###############################################################################
# Reduce build context — keep only what is needed for `docker build`
###############################################################################

# Version-control & metadata
.git
.gitignore
.github/

# IDE / editor files
.idea/
.vscode/
*.iml
.settings/
.project
.classpath

# Build output & local caches
target/
build/
tmp/
*.log
.mvn/timing.properties
/root/.m2/repository/  # copied into builder via cache mount instead

# OS & editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Docs & local orchestration files (not needed inside the image)
README*
LICENSE
compose*.yml
docker-compose*.yml
kubernetes/

# Database dumps & test data (keep them in the repo; no need in runtime image)
dump/
db/

# Other package managers (if added later)
node_modules/
npm-debug.log*
